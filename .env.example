# Copy this file to .env and fill in the values. .env is never committed.
#   cp .env.example .env

# Kaggle API, for the Aalborg pressure gauge data (real dev set, D10).
# kaggle.com > Settings > API > Create New Token downloads kaggle.json;
# copy its "username" and "key" here.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Roboflow API, to list and download Roboflow Universe datasets (Design A
# training candidates). app.roboflow.com > Settings > API Keys: copy the
# Private API Key, not the Publishable one (rf_...).
ROBOFLOW_API_KEY=
